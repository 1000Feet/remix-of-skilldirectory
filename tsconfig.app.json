{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "components/*": [
        "src/components/*"
      ],
      "pages/*": [
        "src/pages/*"
      ],
      "contexts/*": [
        "src/contexts/*"
      ],
      "integrations/*": [
        "src/integrations/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src"
  ]
}